{
  "definitions": [
    {
      "title": "Carousel",
      "id": "carousel",
      "model": "carousel",
      "filter": "carousel",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Carousel Slide",
      "id": "carousel-item",
      "model": "carousel-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "backgroundImage", "selector": "div:nth-child(1)>picture>img[src]"},
            { "name": "backgroundImageAlt", "selector": "div:nth-child(1)>picture>img[alt]"},
            { "name": "text", "selector": "div:nth-child(2)"}
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "valueType": "string",
          "description": "Press = press release image gallery: each slide is an image with a centered title and optional text below. Press + Quote = black quote slider: each slide is one cell with the quote, then the attribution as the last paragraph.",
          "options": [
            { "name": "Press", "value": "press" },
            { "name": "Quote", "value": "quote" },
            { "name": "Large", "value": "large" }
          ]
        }
      ]
    },
    {
      "id": "carousel-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundImage",
          "label": "Background Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "backgroundImageAlt",
          "label": "Background Image Alt"
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel",
      "components": ["carousel-item"]
    }
  ]
}
