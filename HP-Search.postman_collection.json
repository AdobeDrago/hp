{
  "info": {
    "name": "HP Header Search (Federated)",
    "description": "The 5 XHR requests the HP header search bar makes, taken from the HP Search doc.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "keyword", "value": "develop" },
    { "key": "clientGuid", "value": "00000000000000000000000000000000" },
    { "key": "searchGuid", "value": "a1b2c3d4-e5f6-7890-abcd-1234567890ab" }
  ],
  "item": [
    {
      "name": "1. HawkSearch Autocomplete",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-HawkSearch-IgnoreTracking", "value": "false" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"ClientGuid\": \"{{clientGuid}}\",\n  \"Keyword\": \"{{keyword}}\",\n  \"FacetFilters\": {},\n  \"MaxResults\": 5\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "https://hp.searchapi-na.hawksearch.com/api/v2/autocomplete", "protocol": "https", "host": ["hp","searchapi-na","hawksearch","com"], "path": ["api","v2","autocomplete"] },
        "description": "Fires when user types >=2 chars (debounced ~250ms). Returns Categories, Popular, Content."
      }
    },
    {
      "name": "2. HP CSS Knowledge Typeahead",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://css.api.hp.com/knowledge/v2/typeahead/search?q={{keyword}}&resultLimit=3&languageCode=en&store=tmsstore&printFields=productid,productname,seofriendlyname&filters=class:(pm_series_value OR pm_name_value OR pm_number_value)&excludeDescendants=true",
          "protocol": "https", "host": ["css","api","hp","com"], "path": ["knowledge","v2","typeahead","search"],
          "query": [
            { "key": "q", "value": "{{keyword}}" },
            { "key": "resultLimit", "value": "3" },
            { "key": "languageCode", "value": "en" },
            { "key": "store", "value": "tmsstore" },
            { "key": "printFields", "value": "productid,productname,seofriendlyname" },
            { "key": "filters", "value": "class:(pm_series_value OR pm_name_value OR pm_number_value)" },
            { "key": "excludeDescendants", "value": "true" }
          ]
        },
        "description": "Runs in parallel with #1. Returns product series/models/SKUs."
      }
    },
    {
      "name": "3. HawkSearch Track Event",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"EventType\": \"autocomplete_click\",\n  \"EventData\": {\n    \"Keyword\": \"{{keyword}}\",\n    \"SelectedTerm\": \"HP ZBook Studio G8\",\n    \"SelectedUrl\": \"/us-en/shop/pdp/zbook-g8\",\n    \"SearchGuid\": \"{{searchGuid}}\"\n  }\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "https://hp.tracking-na.hawksearch.com/api/trackevent", "protocol": "https", "host": ["hp","tracking-na","hawksearch","com"], "path": ["api","trackevent"] },
        "description": "Fires on suggestion click, popular keyword select, or View All Results."
      }
    },
    {
      "name": "4. Adobe Analytics Beacon",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://hp.sc.omtrdc.net/b/ss/hpcomglobal/1/JS-n/?v12={{keyword}}&pe=lnk_o&pev2=Header_Search_Submit&events=event15",
          "protocol": "https", "host": ["hp","sc","omtrdc","net"], "path": ["b","ss","hpcomglobal","1","JS-n",""],
          "query": [
            { "key": "v12", "value": "{{keyword}}", "description": "eVar12 search term" },
            { "key": "pe", "value": "lnk_o", "description": "Custom link track" },
            { "key": "pev2", "value": "Header_Search_Submit" },
            { "key": "events", "value": "event15", "description": "Search Initiated" }
          ]
        },
        "description": "Fires on search open, submit, or zero-results. Alt host: https://metrics.hp.com/"
      }
    },
    {
      "name": "5. HawkSearch Full Search",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"Keyword\": \"{{keyword}}\",\n  \"PageNo\": 1,\n  \"MaxPerPage\": 12,\n  \"SortBy\": \"score\",\n  \"FacetFilters\": {}\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "https://hp.searchapi-na.hawksearch.com/api/v2/search", "protocol": "https", "host": ["hp","searchapi-na","hawksearch","com"], "path": ["api","v2","search"] },
        "description": "Full paginated results + facets (AJAX SRP)."
      }
    }
  ]
}
