    {
      "title": "Card",
      "id": "card",
      "model": "card",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]"},
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]"},
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "valueType": "string",
          "description": "No style = plain photo + text grid. Spotlight = first row is a full-bleed background photo + heading, followed by small icon + text rows (e.g. a benefits list). Grid = heading row above boxed, bordered cards with image, title, description and a button. Showcase = heading row above centered, borderless cards for a simple image + title + button (e.g. featured products).",
          "options": [
            { "name": "Spotlight", "value": "spotlight" },
            { "name": "Grid", "value": "grid" },
            { "name": "Showcase", "value": "showcase" }
          ]
        }
      ]
    },
    {
      "id": "card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
