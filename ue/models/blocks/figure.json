{
  "definitions": [
    {
      "title": "Figure",
      "id": "figure",
      "model": "figure",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"figure\"><div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture><p><em></em></p></div></div></div>",
          "fields": [
            {
              "name": "image",
              "selector": "div>div>picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div>div>picture>img[alt]"
            },
            {
              "name": "caption",
              "selector": "div>div>p>em"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "figure",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "caption",
          "label": "Caption",
          "value": "",
