{
  "definitions": [
    {
      "title": "Figure",
      "id": "figure",
      "model": "figure",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"figure\"><div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture><p><em></em></p></div></div></div>",
          "fields": [
            {
              "name": "image",
              "selector": "div>div>picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div>div>picture>img[alt]"
            },
            {
              "name": "caption",
              "selector": "div>div>p>em"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "figure",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "caption",
          "label": "Caption",
          "value": "",
          "description": "Optional. Shown centered under the image in small italic text."
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Width",
          "valueType": "string",
          "value": "",
          "description": "How wide the image shows on tablet and desktop, as a share of the column; on mobile it shows at natural size. Natural size = the image's own size, never wider than the column.",
          "options": [
            { "name": "Natural size", "value": "" },
            { "name": "80%", "value": "width-80" },
            { "name": "64%", "value": "width-64" },
            { "name": "50%", "value": "width-50" },
            { "name": "40%", "value": "width-40" }
          ]
        },
        {
          "component": "boolean",
          "name": "classes_right",
          "label": "Float right",
          "description": "On tablet and desktop the image sits on the right and the following text wraps around it; on mobile it shows above the text.",
          "valueType": "boolean"
        },
        {
          "component": "select",
          "name": "classes_height",
          "label": "Box height",
          "valueType": "string",
          "value": "",
          "description": "Optional fixed box height: the image is fitted inside a box this tall (hp.com fixed-height image). With Width 50% the box takes half the column from tablet up.",
          "options": [
            { "name": "Natural size", "value": "" },
            { "name": "300px", "value": "height-300" },
            { "name": "320px", "value": "height-320" },
            { "name": "340px", "value": "height-340" },
            { "name": "360px", "value": "height-360" },
            { "name": "400px", "value": "height-400" }
          ]
        },
        {
          "component": "boolean",
          "name": "classes_heightdesktop",
          "label": "Box height on desktop only",
          "description": "Use the box height from 1280px up; below that the image shows at its own height.",
          "valueType": "boolean"
        }
      ]
    }
  ],
  "filters": []
}
