        },
        {
          "component": "select",
          "name": "classes",
          "label": "Width",
          "valueType": "string",
          "value": "",
          "description": "How wide the image shows on tablet and desktop, as a share of the column; on mobile it shows at natural size. Natural size = the image's own size, never wider than the column.",
          "options": [
            { "name": "Natural size", "value": "" },
            { "name": "80%", "value": "width-80" },
            { "name": "64%", "value": "width-64" },
            { "name": "50%", "value": "width-50" }
          ]
        }
      ]
    }
  ],
  "filters": []
