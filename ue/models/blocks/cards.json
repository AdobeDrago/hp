{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "model": "cards",
      "filter": "cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Card",
      "id": "card",
      "model": "card",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]"},
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]"},
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "valueType": "string",
          "description": "Pick a type and a column count. No style = plain photo + text grid. Icon + 4-up = first row is a full-bleed background photo + heading, followed by small icon + text rows (e.g. a benefits list). Image + 3-up = heading row above boxed, bordered cards with image, title, description and a button. Image + 4-up = heading row above four borderless image cards. Product = heading row above two centered, borderless cards for a simple image + title + button (e.g. featured products); the layout is always two columns, so 2-up is only a label. Image + Left or Image + Right = a single grey band (e.g. a feature section): put the image in the first cell for Left, or in the second cell for Right.",
          "options": [
            { "name": "Icon", "value": "icon" },
            { "name": "Image", "value": "image" },
            { "name": "Product", "value": "product" },
            { "name": "2-up", "value": "2-up" },
            { "name": "3-up", "value": "3-up" },
            { "name": "4-up", "value": "4-up" },
            { "name": "Left", "value": "left" },
            { "name": "Right", "value": "right" },
            { "name": "Press", "value": "press" }
          ]
        }
      ]
    },
    {
      "id": "card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card"
      ]
    }
  ]
}
